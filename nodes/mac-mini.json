{
  "schema_version": 1,
  "node": "mac-mini",
  "role": "Media Server",
  "system": {
    "os": "Debian GNU/Linux 13 (trixie)",
    "kernel": "6.12.116+deb13-amd64",
    "arch": "x86_64",
    "cpu": "Intel(R) Core(TM) i5-4278U CPU @ 2.60GHz",
    "cpu_cores": 4,
    "ram_gb": 7.6,
    "root_disk_gb": 210.3
  },
  "host_services": [
    "Docker",
    "Jellyfin",
    "OpenSSH",
    "WireGuard"
  ],
  "systemd_timers": [
    {
      "name": "homelab-docs",
      "schedule": "*-*-* 04:00:00",
      "description": "Daily Home Lab inventory sync",
      "enabled": "enabled"
    }
  ],
  "docker_containers": [
    {
      "service": "forgejo",
      "container_name": "forgejo",
      "project": "forgejo",
      "image": "codeberg.org/forgejo/forgejo:15",
      "status": "running",
      "networks": [
        "forgejo_default"
      ],
      "ports": [
        "222:22/tcp",
        "3000:3000/tcp"
      ],
      "restart": "always"
    },
    {
      "service": "kavita",
      "container_name": "kavita-server",
      "project": "kavita",
      "image": "jvmilazz0/kavita:latest",
      "status": "running",
      "networks": [
        "kavita_default"
      ],
      "ports": [
        "5000:5000/tcp"
      ],
      "restart": "unless-stopped"
    },
    {
      "service": "node-exporter",
      "container_name": "node-exporter",
      "project": "monitoring",
      "image": "prom/node-exporter",
      "status": "running",
      "networks": [
        "monitoring_default"
      ],
      "ports": [
        "9100:9100/tcp"
      ],
      "restart": "unless-stopped"
    }
  ]
}
